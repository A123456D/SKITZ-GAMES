---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap site-footer__inner">
		<div class="brand-plate">
			<img class="brand" src="/images/skitz-logo-v2.png" alt="SKITZ games & apps" width="200" height="110" />
		</div>
		<p class="note">Free to play. Free Android install. Freemium extras optional — never required.</p>
		<nav class="footer-nav" aria-label="Footer">
			<a href="/games/">Games</a>
			<a href="/about/">About</a>
			<a href="/privacy/">Privacy</a>
		</nav>
		<p class="copy">© {year} SKITZ games &amp; apps</p>
	</div>
</footer>

<style>
	.site-footer {
		padding: 3rem 0 2.25rem;
		border-top: 1px dashed var(--line);
		margin-top: 2.5rem;
	}

	.site-footer__inner {
		display: grid;
		gap: 0.85rem;
		justify-items: start;
	}

	.brand-plate {
		background: #fff;
		padding: 0.3rem 0.45rem;
		clip-path: polygon(2% 6%, 96% 0%, 100% 92%, 4% 100%);
		box-shadow: 3px 3px 0 var(--skitz-yellow);
		transform: rotate(-1deg);
	}

	.brand {
		height: 3.9rem;
		width: auto;
		transform: none;
		filter: none;
	}

	.note {
		margin: 0;
		font-family: var(--font-type);
		color: var(--muted);
		max-width: 28rem;
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-nav a {
		font-family: var(--font-type);
		color: var(--paper);
		text-decoration: none;
	}

	.footer-nav a:hover {
		text-decoration: underline;
	}

	.copy {
		margin: 0.35rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
</style>
