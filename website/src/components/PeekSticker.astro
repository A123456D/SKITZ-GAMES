---
interface Props {
	size?: 'hero' | 'nav';
}

const { size = 'nav' } = Astro.props;
---

<img
	class:list={['peek-sticker', `peek-sticker--${size}`]}
	src="/images/skitz-peek-nav.png"
	alt=""
	width="240"
	height="180"
	aria-hidden="true"
	decoding="async"
	data-peek-sticker
	data-edge="bottom"
/>

<style>
	.peek-sticker {
		position: absolute;
		z-index: 0;
		left: 50%;
		top: 50%;
		pointer-events: none;
		user-select: none;
		opacity: 0;
		transform: translate(-50%, -50%) rotate(0deg);
		filter: drop-shadow(2px 3px 0 rgba(22, 19, 16, 0.16));
		transition:
			opacity 0.35s ease,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.peek-sticker--hero {
		width: min(52px, 12vw);
		height: auto;
	}

	.peek-sticker--nav {
		height: 1.05rem;
		width: auto;
	}

	@media (max-width: 520px) {
		.peek-sticker--hero {
			width: min(42px, 11vw);
		}

		.peek-sticker--nav {
			height: 0.9rem;
		}
	}

	/*
	  Always upright. Slide just far enough that only part of the head clears
	  the painted sticker (the PNG has empty padding, so full-box travel overshoots).
	*/
	.peek-sticker[data-edge='bottom'],
	.peek-sticker[data-edge='top'],
	.peek-sticker[data-edge='left'],
	.peek-sticker[data-edge='right'] {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	.peek-sticker--nav[data-edge='bottom'].is-out {
		opacity: 1;
		transform: translate(-50%, 0.72rem) rotate(0deg);
	}
	.peek-sticker--hero[data-edge='bottom'].is-out {
		opacity: 1;
		transform: translate(-50%, min(5.1rem, 17vw)) rotate(0deg);
	}

	.peek-sticker--nav[data-edge='top'].is-out {
		opacity: 1;
		transform: translate(-50%, -0.72rem) rotate(0deg);
	}
	.peek-sticker--hero[data-edge='top'].is-out {
		opacity: 1;
		transform: translate(-50%, calc(-1 * min(5.1rem, 17vw))) rotate(0deg);
	}

	.peek-sticker--nav[data-edge='left'].is-out {
		opacity: 1;
		transform: translate(-1.05rem, -50%) rotate(0deg);
	}
	.peek-sticker--hero[data-edge='left'].is-out {
		opacity: 1;
		transform: translate(calc(-1 * min(5.6rem, 19vw)), -50%) rotate(0deg);
	}

	.peek-sticker--nav[data-edge='right'].is-out {
		opacity: 1;
		transform: translate(1.05rem, -50%) rotate(0deg);
	}
	.peek-sticker--hero[data-edge='right'].is-out {
		opacity: 1;
		transform: translate(min(5.6rem, 19vw), -50%) rotate(0deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.peek-sticker {
			display: none;
		}
	}
</style>

<script>
	const EDGES = ['bottom', 'top', 'left', 'right'];
	const PEEK_MS = 3000;
	const CYCLE_MS = 10000;

	function nextEdge(prev) {
		const pool = prev ? EDGES.filter((e) => e !== prev) : EDGES.slice();
		return pool[Math.floor(Math.random() * pool.length)];
	}

	function startPeek(el, delay) {
		let prev = null;
		let outTimer = 0;
		let cycleTimer = 0;

		const hide = () => {
			el.classList.remove('is-out');
		};

		const show = () => {
			const edge = nextEdge(prev);
			prev = edge;
			el.dataset.edge = edge;
			el.classList.remove('is-out');
			void el.offsetWidth;
			el.classList.add('is-out');
			window.clearTimeout(outTimer);
			outTimer = window.setTimeout(hide, PEEK_MS);
		};

		const arm = () => {
			window.clearTimeout(cycleTimer);
			cycleTimer = window.setTimeout(() => {
				show();
				arm();
			}, CYCLE_MS);
		};

		window.setTimeout(() => {
			show();
			arm();
		}, delay);
	}

	function boot() {
		document.querySelectorAll('[data-peek-sticker]').forEach((el, i) => {
			if (!(el instanceof HTMLElement)) return;
			if (el.dataset.peekReady === '1') return;
			el.dataset.peekReady = '1';
			startPeek(el, 800 + i * 4500);
		});
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
