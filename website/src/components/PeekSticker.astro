---
interface Props {
	size?: 'hero' | 'nav';
}

const { size = 'nav' } = Astro.props;
---

<img
	class:list={['peek-sticker', `peek-sticker--${size}`]}
	src="/images/skitz-peek-nav.png"
	alt=""
	width="240"
	height="180"
	aria-hidden="true"
	decoding="async"
	data-peek-sticker
/>

<style>
	.peek-sticker {
		position: absolute;
		z-index: 0;
		left: 50%;
		/* Anchor at the top edge of the logo; tucked fully under until .is-out. */
		top: 0;
		pointer-events: none;
		user-select: none;
		opacity: 0;
		transform: translate(-50%, 0);
		filter: drop-shadow(2px 3px 0 rgba(22, 19, 16, 0.16));
		transition:
			opacity 0.35s ease,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.peek-sticker--hero {
		width: min(52px, 12vw);
		height: auto;
	}

	.peek-sticker--nav {
		height: 1.05rem;
		width: auto;
	}

	@media (max-width: 520px) {
		.peek-sticker--hero {
			width: min(42px, 11vw);
		}

		.peek-sticker--nav {
			height: 0.9rem;
		}
	}

	/* Half the sticker above the logo top edge. */
	.peek-sticker.is-out {
		opacity: 1;
		transform: translate(-50%, -50%);
	}

	@media (prefers-reduced-motion: reduce) {
		.peek-sticker {
			display: none;
		}
	}
</style>

<script>
	const PEEK_MS = 3000;
	const CYCLE_MS = 10000;

	function startPeek(el, delay) {
		let outTimer = 0;
		let cycleTimer = 0;

		const hide = () => {
			el.classList.remove('is-out');
		};

		const show = () => {
			el.classList.remove('is-out');
			void el.offsetWidth;
			el.classList.add('is-out');
			window.clearTimeout(outTimer);
			outTimer = window.setTimeout(hide, PEEK_MS);
		};

		const arm = () => {
			window.clearTimeout(cycleTimer);
			cycleTimer = window.setTimeout(() => {
				show();
				arm();
			}, CYCLE_MS);
		};

		window.setTimeout(() => {
			show();
			arm();
		}, delay);
	}

	function boot() {
		document.querySelectorAll('[data-peek-sticker]').forEach((el, i) => {
			if (!(el instanceof HTMLElement)) return;
			if (el.dataset.peekReady === '1') return;
			el.dataset.peekReady = '1';
			startPeek(el, 800 + i * 4500);
		});
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
