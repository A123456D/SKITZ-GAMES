---
interface Props {
	apkHref: string;
	cover: string;
	heroArt: string;
	phoneArt: string;
}

const { apkHref, phoneArt } = Astro.props;
---

<main class="site-main cc" data-cc="cc-layout-v2">
	<section class="cc-hero" aria-labelledby="cc-title">
		<div class="wrap cc-hero__grid">
			<div class="cc-hero__copy">
				<p class="cc-kicker">SKITZ · Android remote</p>
				<h1 id="cc-title" class="cc-title">Skitz Controller</h1>
				<p class="cc-line">Your phone is the mouse and keyboard.</p>
				<p class="cc-sub">
					Pair over Bluetooth. No PC install. Windows and Mac see a normal cursor and keys.
				</p>
				<div class="btn-row cc-cta">
					<a class="btn cc-cta__primary" href={apkHref} download>Download APK</a>
					<a class="btn btn-ghost" href="#install">How to pair</a>
				</div>
				<p class="cc-req">Android 9+ · Bluetooth HID · free sideload</p>
			</div>

			<figure class="cc-phone">
				<img
					src={phoneArt}
					alt="Skitz Controller touchpad screen on a phone"
					width="720"
					height="1280"
				/>
			</figure>
		</div>
	</section>

	<section class="cc-moves" aria-label="What it does">
		<div class="wrap cc-moves__row">
			<div class="cc-move cc-move--red">
				<span class="cc-move__n">01</span>
				<strong>Touchpad</strong>
				<em>Drag · tap · two-finger scroll</em>
			</div>
			<div class="cc-move cc-move--blue">
				<span class="cc-move__n">02</span>
				<strong>Keys</strong>
				<em>Letters · mods · arrows</em>
			</div>
			<div class="cc-move cc-move--green">
				<span class="cc-move__n">03</span>
				<strong>Bluetooth</strong>
				<em>Shows up as real HID</em>
			</div>
		</div>
	</section>

	<section class="section cc-pair" id="install">
		<div class="wrap">
			<p class="eyebrow">install</p>
			<h2 class="section-title">Sideload. Pair. Click.</h2>
			<p class="cc-pair__lead muted">
				Four steps. No companion app on the PC — your phone becomes the input device.
			</p>

			<ol class="cc-steps">
				<li>
					<span class="cc-steps__n">1</span>
					<div>
						<strong>Download the APK</strong>
						<p>Grab it on your Android phone from this page.</p>
						<a class="btn" href={apkHref} download id="install-open">Download APK</a>
					</div>
				</li>
				<li>
					<span class="cc-steps__n">2</span>
					<div>
						<strong>Install Skitz Controller</strong>
						<p>Allow installs from this browser if prompted, then open the app.</p>
					</div>
				</li>
				<li>
					<span class="cc-steps__n">3</span>
					<div>
						<strong>Make the phone discoverable</strong>
						<p>Allow Bluetooth, tap Make phone discoverable.</p>
					</div>
				</li>
				<li>
					<span class="cc-steps__n">4</span>
					<div>
						<strong>Pair from the PC</strong>
						<p>Bluetooth → Add device → select Skitz Controller → use Pad and Keys.</p>
					</div>
				</li>
			</ol>

					<p class="cc-warn muted">
						Needs Android 9+ with Bluetooth HID Device support. Pixels are solid; some OEMs disable the
						profile. iOS can’t do this.
					</p>
					<p class="cc-warn muted">
						Updating from an older install? Uninstall the old app first, then download this APK again. Re-pair as <strong>Skitz Controller</strong>.
					</p>
		</div>
	</section>

	<section class="section cc-free">
		<div class="wrap">
			<div class="sticker cc-free__card">
				<p class="eyebrow">free</p>
				<h2 class="section-title">Free APK. No PC install.</h2>
				<p>
					Sideload once, pair over Bluetooth, control the desk — no account, no store, no companion
					software.
				</p>
			</div>
		</div>
	</section>
</main>

<style>
	.cc-hero {
		padding: 1.75rem 0 2.25rem;
	}

	.cc-hero__grid {
		display: grid;
		gap: 2rem;
		align-items: center;
	}

	@media (min-width: 800px) {
		.cc-hero__grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.75fr);
			gap: 2.75rem;
		}
	}

	.cc-hero__copy {
		min-width: 0;
	}

	.cc-kicker {
		margin: 0 0 0.75rem;
		font-family: var(--font-type);
		font-size: 0.95rem;
		color: var(--muted);
	}

	.cc-title {
		display: block;
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.04em;
		font-size: clamp(2.6rem, 9vw, 4.8rem);
		line-height: 0.95;
		color: #0b1220;
	}

	.cc-line {
		margin: 0 0 0.55rem;
		font-family: var(--font-type);
		font-size: clamp(1.1rem, 2.5vw, 1.45rem);
		color: var(--mark);
	}

	.cc-sub {
		margin: 0 0 1.35rem;
		max-width: 28rem;
		color: var(--muted);
		font-size: 0.98rem;
	}

	.cc-cta__primary {
		box-shadow: 5px 5px 0 var(--skitz-red) !important;
		font-size: 1.05rem;
		padding: 0.95rem 1.5rem;
	}

	.cc-req {
		margin: 1rem 0 0;
		font-family: var(--font-body);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.cc-phone {
		margin: 0;
		justify-self: center;
		width: min(100%, 260px);
		padding: 0.55rem;
		background: #fff;
		border: 3px solid var(--mark);
		box-shadow: 8px 9px 0 var(--skitz-blue);
		transform: rotate(1.5deg);
	}

	.cc-phone img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		object-position: top center;
		background: #f7f2e8;
	}

	@media (min-width: 800px) {
		.cc-phone {
			width: min(100%, 300px);
			justify-self: end;
		}
	}

	.cc-moves {
		padding: 0.5rem 0 0.75rem;
	}

	.cc-moves__row {
		display: grid;
		gap: 0.85rem;
	}

	@media (min-width: 760px) {
		.cc-moves__row {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
		}
	}

	.cc-move {
		padding: 1.1rem 1rem 1rem;
		border: 3px solid var(--mark);
		background: rgba(255, 254, 249, 0.72);
	}

	.cc-move--red {
		box-shadow: 6px 6px 0 var(--skitz-red);
	}
	.cc-move--blue {
		box-shadow: 6px 6px 0 var(--skitz-blue);
	}
	.cc-move--green {
		box-shadow: 6px 6px 0 var(--skitz-green);
	}

	.cc-move__n {
		display: block;
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin-bottom: 0.35rem;
	}

	.cc-move strong {
		display: block;
		font-family: var(--font-display);
		font-size: 1.55rem;
		text-transform: uppercase;
		letter-spacing: -0.02em;
		margin-bottom: 0.25rem;
	}

	.cc-move em {
		font-family: var(--font-type);
		font-style: normal;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.cc-pair__lead {
		max-width: 34rem;
		margin-bottom: 1.75rem;
		font-family: var(--font-type);
	}

	.cc-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.cc-steps li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: start;
		padding: 1.1rem 1.1rem 1.15rem;
		border: 3px solid var(--mark);
		background: rgba(255, 254, 249, 0.65);
		box-shadow: 5px 5px 0 var(--skitz-yellow);
	}

	.cc-steps li:nth-child(2) {
		box-shadow: 5px 5px 0 var(--skitz-red);
	}
	.cc-steps li:nth-child(3) {
		box-shadow: 5px 5px 0 var(--skitz-blue);
	}
	.cc-steps li:nth-child(4) {
		box-shadow: 5px 5px 0 var(--skitz-green);
	}

	.cc-steps__n {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border: 2.5px solid var(--mark);
		background: var(--mark);
		color: var(--paper);
		font-family: var(--font-display);
		font-size: 1.15rem;
	}

	.cc-steps strong {
		display: block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		text-transform: uppercase;
		margin-bottom: 0.25rem;
	}

	.cc-steps p {
		margin: 0 0 0.85rem;
		color: var(--muted);
		font-family: var(--font-type);
		font-size: 0.98rem;
	}

	.cc-warn {
		margin-top: 1.5rem;
		max-width: 40rem;
		font-size: 0.9rem;
		font-family: var(--font-body);
	}

	.cc-free__card {
		padding: 1.5rem 1.35rem 1.35rem;
		max-width: 38rem;
		transform: rotate(-0.8deg);
	}

	.cc-free__card p:last-child {
		margin: 0;
		font-family: var(--font-type);
		font-size: 1.05rem;
		color: var(--mark);
	}
</style>

<script>
	function focusInstall() {
		const hash = window.location.hash;
		if (hash !== '#install' && hash !== '#downloads') return;
		const block = document.getElementById('install');
		if (!block) return;
		block.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}
	focusInstall();
	window.addEventListener('hashchange', focusInstall);
</script>
