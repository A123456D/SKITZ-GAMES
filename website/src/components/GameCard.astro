---
interface Props {
	href: string;
	title: string;
	summary: string;
	cover: string;
	preview?: string;
	genre?: string;
}

const { href, title, summary, cover, preview, genre } = Astro.props;
---

<a class="game-link" href={href}>
	<article class="game-item">
		<div class={`game-item__media${preview ? ' game-item__media--pair' : ''}`}>
			<img class="game-item__cover" src={cover} alt="" width="640" height="640" loading="lazy" />
			{
				preview && (
					<img
						class="game-item__preview"
						src={preview}
						alt={`${title} gameplay preview`}
						width="480"
						height="780"
						loading="lazy"
					/>
				)
			}
		</div>
		<div class="game-item__body">
			{genre && <p class="eyebrow">{genre}</p>}
			<h2>{title}</h2>
			<p class="muted">{summary}</p>
			<span class="cta">view game →</span>
		</div>
	</article>
</a>

<style>
	.game-link {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.game-item {
		display: grid;
		gap: 0.9rem;
		height: 100%;
		padding: 0.35rem 0.15rem 0.5rem;
		transition: transform 180ms var(--ease);
	}

	.game-link:hover .game-item {
		transform: translateY(-5px);
	}

	.game-item__media {
		width: 100%;
		max-width: 280px;
		margin-inline: auto;
		background: #fff;
		padding: 0.45rem;
		box-shadow: 5px 6px 0 var(--skitz-red);
		clip-path: polygon(2% 4%, 96% 0%, 100% 94%, 4% 100%);
		transform: rotate(-1.2deg);
	}

	.game-item__media--pair {
		max-width: 100%;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 0.45rem;
		align-items: center;
		padding: 0.5rem;
		clip-path: none;
		border-radius: 0.2rem;
	}

	.game-link:nth-child(even) .game-item__media {
		box-shadow: 5px 6px 0 var(--skitz-blue);
		transform: rotate(1deg);
	}

	.game-link:nth-child(3n) .game-item__media {
		box-shadow: 5px 6px 0 var(--skitz-green);
		transform: rotate(-0.6deg);
	}

	.game-item__cover {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.game-item__preview {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		object-position: top center;
		background: #111;
	}

	.game-item__body {
		text-align: center;
	}

	.game-item__body h2 {
		font-size: clamp(1.55rem, 3.2vw, 2rem);
		margin-bottom: 0.35rem;
	}

	.game-item__body .muted {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-bottom: 0.55rem;
		font-size: 0.95rem;
	}

	.cta {
		font-family: var(--font-type);
		color: var(--skitz-blue);
	}

	.game-link:hover .cta {
		color: var(--skitz-red);
	}
</style>
