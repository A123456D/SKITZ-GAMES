---
interface Props {
	title: string;
	src: string;
	backHref: string;
}

const { title, src, backHref } = Astro.props;
---

<div class="play-shell">
	<header class="play-chrome">
		<a class="back" href={backHref}>← {title}</a>
		<p class="hint">Tap once if audio does not start — mobile browsers require a gesture.</p>
	</header>
	<div class="play-stage">
		<iframe
			class="play-frame"
			title={`${title} — play online`}
			src={src}
			allow="autoplay; fullscreen; gamepad; accelerometer; gyroscope"
			allowfullscreen
			loading="eager"
		></iframe>
	</div>
</div>

<style>
	.play-shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
		background: #000;
		animation: rise 400ms var(--ease);
	}

	.play-chrome {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 1rem;
		padding-top: max(0.7rem, env(safe-area-inset-top));
		background: #050505;
		border-bottom: 1px dashed var(--line);
	}

	.back {
		font-family: var(--font-display);
		font-size: 0.95rem;
		text-transform: uppercase;
		color: var(--paper);
		text-decoration: none;
	}

	.back:hover {
		color: #fff;
	}

	.hint {
		margin: 0;
		font-family: var(--font-type);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.play-stage {
		flex: 1;
		position: relative;
		min-height: 0;
		background: #000;
	}

	.play-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
	}
</style>
