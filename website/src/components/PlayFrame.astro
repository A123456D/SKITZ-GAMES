---
interface Props {
	title: string;
	src: string;
}

const { title, src } = Astro.props;
---

<div class="play-shell">
	<div class="play-stage">
		<iframe
			class="play-frame"
			title={`${title} — play online`}
			src={src}
			allow="autoplay; fullscreen; gamepad; accelerometer; gyroscope"
			allowfullscreen
			loading="eager"
		></iframe>
	</div>
</div>

<style>
	.play-shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
		background: #000;
		animation: rise 400ms var(--ease);
	}

	.play-stage {
		flex: 1;
		position: relative;
		min-height: 0;
		background: #000;
	}

	.play-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
		-webkit-tap-highlight-color: transparent;
	}

	.play-shell,
	.play-stage {
		-webkit-tap-highlight-color: transparent;
	}

	@media (max-width: 820px), (pointer: coarse) {
		.play-shell {
			position: fixed;
			inset: 0;
			width: 100%;
			height: 100%;
			height: 100dvh;
			min-height: 100dvh;
			animation: none;
		}

		.play-stage {
			position: absolute;
			inset: 0;
			flex: none;
		}
	}
</style>
