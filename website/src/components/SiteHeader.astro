---
const path = Astro.url.pathname;
const links = [
	{ href: '/games/', label: 'Games' },
	{ href: '/about/', label: 'About' },
];
---

<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="logo" href="/" aria-label="SKITZ home">
			<img
				class="logo__peek"
				src="/images/skitz-peek-nav.png"
				alt=""
				width="240"
				height="180"
				aria-hidden="true"
				decoding="async"
			/>
			<img
				class="logo__mark"
				src="/images/skitz-mark.png"
				alt="SKITZ games & apps"
				width="220"
				height="120"
			/>
		</a>
		<nav class="nav" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={['nav__link', { 'is-active': path.startsWith(link.href) }]}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-h);
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
		overflow: visible;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		gap: 1rem;
		overflow: visible;
	}

	.logo {
		position: relative;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		transform: rotate(-1.5deg);
		overflow: visible;
		isolation: isolate;
		padding-right: 0.45rem;
		margin-right: -0.15rem;
	}

	.logo__peek {
		position: absolute;
		z-index: 0;
		height: 1.85rem;
		width: auto;
		pointer-events: none;
		user-select: none;
		/* Peek from the upper-right — opposite side from the home hero. */
		right: -0.15rem;
		top: -0.35rem;
		transform: rotate(7deg) translate(35%, -55%);
		opacity: 0;
		filter: drop-shadow(2px 2px 0 rgba(22, 19, 16, 0.14));
		/* Same 3s / 10s cadence, offset so nav peeks between hero peeks. */
		animation: nav-peek-cycle 10s ease-in-out 5s infinite;
		will-change: transform, opacity;
	}

	.logo__mark {
		position: relative;
		z-index: 1;
		height: 3.25rem;
		width: auto;
		filter: drop-shadow(3px 3px 0 rgba(22, 19, 16, 0.18));
		animation: nav-logo-hover 3.4s ease-in-out infinite;
		will-change: transform;
	}

	@media (max-width: 520px) {
		.logo {
			padding-right: 0.3rem;
		}

		.logo__peek {
			height: 1.55rem;
			right: -0.05rem;
			top: -0.25rem;
		}

		.logo__mark {
			height: 2.85rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.logo {
			transition: transform 160ms var(--ease);
		}

		.logo:hover {
			transform: rotate(-0.2deg) scale(1.05);
		}

		.logo:hover .logo__mark {
			animation: nav-logo-hover-strong 3.4s ease-in-out infinite;
			filter: drop-shadow(4px 7px 0 rgba(22, 19, 16, 0.24));
		}
	}

	@keyframes nav-logo-hover {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes nav-logo-hover-strong {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(-7px);
		}
	}

	@keyframes nav-peek-cycle {
		0%,
		2% {
			opacity: 0;
			transform: rotate(7deg) translate(35%, -55%);
		}
		6%,
		30% {
			opacity: 1;
			transform: rotate(7deg) translate(0, 0);
		}
		34%,
		100% {
			opacity: 0;
			transform: rotate(7deg) translate(35%, -55%);
		}
	}

	.nav {
		display: flex;
		gap: 0.65rem;
	}

	.nav__link {
		font-family: var(--font-type);
		font-size: 0.95rem;
		color: var(--mark);
		text-decoration: none;
		padding: 0.35rem 0.7rem;
		border: 2px solid transparent;
	}

	.nav__link:hover,
	.nav__link.is-active {
		border-color: var(--mark);
		background: #fffef9;
		color: var(--mark);
		box-shadow: 3px 3px 0 var(--skitz-red);
	}

	.nav__link:nth-child(2):hover,
	.nav__link:nth-child(2).is-active {
		box-shadow: 3px 3px 0 var(--skitz-blue);
	}
</style>
