---
const path = Astro.url.pathname;
const links = [
	{ href: '/games/', label: 'Games' },
	{ href: '/about/', label: 'About' },
];
---

<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="logo" href="/" aria-label="SKITZ home">
			<img
				class="logo__peek"
				src="/images/skitz-peek-nav.png"
				alt=""
				width="240"
				height="180"
				aria-hidden="true"
				decoding="async"
			/>
			<img
				class="logo__mark"
				src="/images/skitz-mark.png"
				alt="SKITZ games & apps"
				width="220"
				height="120"
			/>
		</a>
		<nav class="nav" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={['nav__link', { 'is-active': path.startsWith(link.href) }]}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-h);
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
		overflow: visible;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		gap: 1rem;
		overflow: visible;
	}

	.logo {
		position: relative;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		transform: rotate(-1.5deg);
		overflow: visible;
		isolation: isolate;
	}

	.logo__peek {
		position: absolute;
		z-index: 0;
		height: 1.15rem;
		width: auto;
		left: 18%;
		bottom: 2%;
		pointer-events: none;
		user-select: none;
		transform: translate(-50%, 120%);
		opacity: 0;
		filter: drop-shadow(1px 2px 0 rgba(22, 19, 16, 0.14));
		/* Same bottom-edge tour; start mid-cycle so nav doesn't match home. */
		animation: nav-bottom-peeks 50s linear 5s infinite;
		will-change: transform, opacity, left;
	}

	.logo__mark {
		position: relative;
		z-index: 1;
		height: 3.25rem;
		width: auto;
		filter: drop-shadow(3px 3px 0 rgba(22, 19, 16, 0.18));
		animation: nav-logo-hover 3.4s ease-in-out infinite;
		will-change: transform;
	}

	@media (max-width: 520px) {
		.logo__peek {
			height: 0.95rem;
		}

		.logo__mark {
			height: 2.85rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.logo {
			transition: transform 160ms var(--ease);
		}

		.logo:hover {
			transform: rotate(-0.2deg) scale(1.05);
		}

		.logo:hover .logo__mark {
			animation: nav-logo-hover-strong 3.4s ease-in-out infinite;
			filter: drop-shadow(4px 7px 0 rgba(22, 19, 16, 0.24));
		}
	}

	@keyframes nav-logo-hover {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes nav-logo-hover-strong {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(-7px);
		}
	}

	@keyframes nav-bottom-peeks {
		/* right first (offset feel from hero) */
		0%,
		0.6% {
			left: 82%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(8deg);
		}
		1.4%,
		6% {
			left: 82%;
			opacity: 1;
			transform: translate(-50%, 18%) rotate(6deg);
		}
		7%,
		19.9% {
			left: 82%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(8deg);
		}

		/* mid-right */
		20%,
		20.6% {
			left: 66%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(3deg);
		}
		21.4%,
		26% {
			left: 66%;
			opacity: 1;
			transform: translate(-50%, 16%) rotate(2deg);
		}
		27%,
		39.9% {
			left: 66%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(3deg);
		}

		/* center */
		40%,
		40.6% {
			left: 50%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(0deg);
		}
		41.4%,
		46% {
			left: 50%;
			opacity: 1;
			transform: translate(-50%, 14%) rotate(0deg);
		}
		47%,
		59.9% {
			left: 50%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(0deg);
		}

		/* mid-left */
		60%,
		60.6% {
			left: 34%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(-3deg);
		}
		61.4%,
		66% {
			left: 34%;
			opacity: 1;
			transform: translate(-50%, 16%) rotate(-2deg);
		}
		67%,
		79.9% {
			left: 34%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(-3deg);
		}

		/* left */
		80%,
		80.6% {
			left: 18%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(-8deg);
		}
		81.4%,
		86% {
			left: 18%;
			opacity: 1;
			transform: translate(-50%, 18%) rotate(-6deg);
		}
		87%,
		100% {
			left: 18%;
			opacity: 0;
			transform: translate(-50%, 125%) rotate(-8deg);
		}
	}

	.nav {
		display: flex;
		gap: 0.65rem;
	}

	.nav__link {
		font-family: var(--font-type);
		font-size: 0.95rem;
		color: var(--mark);
		text-decoration: none;
		padding: 0.35rem 0.7rem;
		border: 2px solid transparent;
	}

	.nav__link:hover,
	.nav__link.is-active {
		border-color: var(--mark);
		background: #fffef9;
		color: var(--mark);
		box-shadow: 3px 3px 0 var(--skitz-red);
	}

	.nav__link:nth-child(2):hover,
	.nav__link:nth-child(2).is-active {
		box-shadow: 3px 3px 0 var(--skitz-blue);
	}
</style>
