---
const path = Astro.url.pathname;
const links = [
	{ href: '/games/', label: 'Games' },
	{ href: '/about/', label: 'About' },
];
---

<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="logo" href="/" aria-label="SKITZ home">
			<img
				class="logo__peek"
				src="/images/skitz-peek-nav.png"
				alt=""
				width="240"
				height="180"
				aria-hidden="true"
				decoding="async"
			/>
			<img
				class="logo__mark"
				src="/images/skitz-mark.png"
				alt="SKITZ games & apps"
				width="220"
				height="120"
			/>
		</a>
		<nav class="nav" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={['nav__link', { 'is-active': path.startsWith(link.href) }]}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: var(--header-h);
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
		overflow: visible;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		gap: 1rem;
		overflow: visible;
	}

	.logo {
		position: relative;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		transform: rotate(-1.5deg);
		overflow: visible;
		isolation: isolate;
	}

	.logo__peek {
		position: absolute;
		z-index: 0;
		top: 50%;
		left: 50%;
		height: 1.05rem;
		width: auto;
		pointer-events: none;
		user-select: none;
		transform: translate(-50%, -50%) scale(0.92);
		opacity: 0;
		filter: drop-shadow(1px 2px 0 rgba(22, 19, 16, 0.14));
		animation: nav-edge-peeks 40s linear 5s infinite;
		will-change: top, left, opacity, transform;
	}

	.logo__mark {
		position: relative;
		z-index: 1;
		height: 3.25rem;
		width: auto;
		filter: drop-shadow(3px 3px 0 rgba(22, 19, 16, 0.18));
		animation: nav-logo-hover 3.4s ease-in-out infinite;
		will-change: transform;
	}

	@media (max-width: 520px) {
		.logo__peek {
			height: 0.9rem;
		}

		.logo__mark {
			height: 2.85rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.logo {
			transition: transform 160ms var(--ease);
		}

		.logo:hover {
			transform: rotate(-0.2deg) scale(1.05);
		}

		.logo:hover .logo__mark {
			animation: nav-logo-hover-strong 3.4s ease-in-out infinite;
			filter: drop-shadow(4px 7px 0 rgba(22, 19, 16, 0.24));
		}
	}

	@keyframes nav-logo-hover {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes nav-logo-hover-strong {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(-7px);
		}
	}

	@keyframes nav-edge-peeks {
		/* top — upside down */
		0%,
		1% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(180deg) scale(0.92);
		}
		3%,
		7.5% {
			top: 6%;
			left: 48%;
			opacity: 1;
			transform: translate(-50%, -65%) rotate(180deg) scale(1);
		}
		9.5%,
		24.9% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(180deg) scale(0.92);
		}

		/* bottom — upright */
		25%,
		26% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(0deg) scale(0.92);
		}
		28%,
		32.5% {
			top: 94%;
			left: 52%;
			opacity: 1;
			transform: translate(-50%, -30%) rotate(0deg) scale(1);
		}
		34.5%,
		49.9% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(0deg) scale(0.92);
		}

		/* left — head out left */
		50%,
		51% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(-90deg) scale(0.92);
		}
		53%,
		57.5% {
			top: 52%;
			left: 4%;
			opacity: 1;
			transform: translate(-70%, -50%) rotate(-90deg) scale(1);
		}
		59.5%,
		74.9% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(-90deg) scale(0.92);
		}

		/* right — head out right */
		75%,
		76% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(90deg) scale(0.92);
		}
		78%,
		82.5% {
			top: 48%;
			left: 96%;
			opacity: 1;
			transform: translate(-30%, -50%) rotate(90deg) scale(1);
		}
		84.5%,
		100% {
			top: 50%;
			left: 50%;
			opacity: 0;
			transform: translate(-50%, -50%) rotate(90deg) scale(0.92);
		}
	}

	.nav {
		display: flex;
		gap: 0.65rem;
	}

	.nav__link {
		font-family: var(--font-type);
		font-size: 0.95rem;
		color: var(--mark);
		text-decoration: none;
		padding: 0.35rem 0.7rem;
		border: 2px solid transparent;
	}

	.nav__link:hover,
	.nav__link.is-active {
		border-color: var(--mark);
		background: #fffef9;
		color: var(--mark);
		box-shadow: 3px 3px 0 var(--skitz-red);
	}

	.nav__link:nth-child(2):hover,
	.nav__link:nth-child(2).is-active {
		box-shadow: 3px 3px 0 var(--skitz-blue);
	}
</style>
