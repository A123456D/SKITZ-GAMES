---
interface Downloads {
	windows?: string;
	android?: string;
	macos?: string;
	linux?: string;
}

interface Props {
	slug: string;
	title: string;
	downloads: Downloads;
	appStoreUrl?: string;
	playStoreUrl?: string;
	platforms: {
		web: boolean;
		windows: boolean;
		android: boolean;
		macos: boolean;
		linux: boolean;
		ios: boolean;
	};
}

const { slug, title, downloads, playStoreUrl, platforms } = Astro.props;

const desktop = [
	{ key: 'windows', label: 'Windows', href: downloads.windows },
	{ key: 'macos', label: 'macOS', href: downloads.macos },
	{ key: 'linux', label: 'Linux', href: downloads.linux },
].filter((item) => item.href);

const androidHref = downloads.android;
const showPlayStore = Boolean(playStoreUrl);
const playHref = `/games/${slug}/play/`;
const canInstallAndroid = platforms.web || platforms.android;
---

<section class="downloads" aria-labelledby="downloads-heading">
	<h2 id="downloads-heading" class="section-title">Download &amp; install</h2>
	<p class="muted intro">
		Play free in the browser. On Android, install {title} from Chrome — home-screen icon,
		fullscreen, no store required.
	</p>

	{
		canInstallAndroid && (
			<div class="block install-block" id="install">
				<h3>Android — install</h3>
				<div class="btn-row">
					<a class="btn" href={playHref} id="install-open">
						Open game to install
					</a>
					{androidHref && (
						<a class="btn btn-ghost" href={androidHref} download>
							Download APK
						</a>
					)}
					{showPlayStore && (
						<a class="btn btn-ghost" href={playStoreUrl} rel="noopener noreferrer" target="_blank">
							Google Play
						</a>
					)}
				</div>
				<details class="help" id="install-help" open>
					<summary>How to install</summary>
					<ol>
						<li>
							Tap <strong>Open game to install</strong> (Chrome on Android).
						</li>
						<li>
							Tap the menu (⋮) → <strong>Install app</strong> or <strong>Add to Home screen</strong>.
						</li>
						<li>Confirm — {title} lands on your home screen and opens fullscreen.</li>
					</ol>
				</details>
			</div>
		)
	}

	{
		desktop.length > 0 && (
			<div class="block">
				<h3>Desktop</h3>
				<div class="btn-row">
					{desktop.map((item) => (
						<a class="btn btn-ghost" href={item.href} download>
							Download {item.label}
						</a>
					))}
				</div>
			</div>
		)
	}

	{
		desktop.length === 0 && !canInstallAndroid && !androidHref && !showPlayStore && (
			<p class="muted">Downloads are not published yet.</p>
		)
	}
</section>

<script>
	function focusInstall() {
		const hash = window.location.hash;
		if (hash !== '#install' && hash !== '#downloads') return;
		const block = document.getElementById('install');
		if (!block) return;
		const help = document.getElementById('install-help');
		if (help instanceof HTMLDetailsElement) help.open = true;
		block.classList.add('is-focused');
		block.scrollIntoView({ behavior: 'smooth', block: 'center' });
		window.setTimeout(() => block.classList.remove('is-focused'), 2200);
	}

	focusInstall();
	window.addEventListener('hashchange', focusInstall);
</script>

<style>
	.downloads {
		padding: 2rem 0 0.5rem;
	}

	.intro {
		max-width: 38rem;
		margin-bottom: 1.5rem;
		font-family: var(--font-type);
	}

	.block {
		padding: 1.25rem 0;
		border-top: 1px dashed var(--line);
	}

	.install-block {
		padding: 1.35rem 1.15rem;
		margin: 0.35rem 0 0.5rem;
		border: 3px solid var(--paper);
		background: rgba(255, 255, 255, 0.04);
		box-shadow: 6px 6px 0 var(--skitz-yellow);
		clip-path: polygon(0 6%, 3% 0, 100% 0, 100% 92%, 97% 100%, 0 100%);
		transition:
			box-shadow 220ms var(--ease),
			background 220ms var(--ease);
	}

	.install-block.is-focused {
		background: rgba(232, 163, 23, 0.12);
		box-shadow: 8px 8px 0 var(--skitz-red);
	}

	.block h3 {
		font-family: var(--font-type);
		font-size: 1.15rem;
		text-transform: none;
		letter-spacing: 0;
		margin-bottom: 0.85rem;
	}

	.help {
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.help summary {
		cursor: pointer;
		font-family: var(--font-type);
		color: var(--paper);
	}

	.help ol {
		margin: 0.75rem 0 0;
		padding-left: 1.2rem;
	}
</style>
