---
interface Downloads {
	windows?: string;
	android?: string;
	macos?: string;
	linux?: string;
}

interface Props {
	slug: string;
	downloads: Downloads;
	appStoreUrl?: string;
	playStoreUrl?: string;
	platforms: {
		web: boolean;
		windows: boolean;
		android: boolean;
		macos: boolean;
		linux: boolean;
		ios: boolean;
	};
}

const { slug, downloads, playStoreUrl, platforms } = Astro.props;

const desktop = [
	{ key: 'windows', label: 'Windows', href: downloads.windows },
	{ key: 'macos', label: 'macOS', href: downloads.macos },
	{ key: 'linux', label: 'Linux', href: downloads.linux },
].filter((item) => item.href);

const androidHref = downloads.android;
const showPlayStore = Boolean(playStoreUrl);
const playHref = `/games/${slug}/play/`;
const canInstallAndroid = platforms.web;
---

<section class="downloads" aria-labelledby="downloads-heading">
	<h2 id="downloads-heading" class="section-title">Get it on your phone</h2>
	<p class="muted intro">
		On Android, install Pulse Link like an app from Chrome — home screen icon, fullscreen, no
		Play Store needed.
	</p>

	{
		canInstallAndroid && (
			<div class="block">
				<h3>Android — install</h3>
				<div class="btn-row">
					<a class="btn" href={playHref}>
						Open game
					</a>
					{androidHref && (
						<a class="btn btn-ghost" href={androidHref} download>
							Download APK
						</a>
					)}
					{showPlayStore && (
						<a class="btn btn-ghost" href={playStoreUrl} rel="noopener noreferrer" target="_blank">
							Google Play
						</a>
					)}
				</div>
				<details class="help" open>
					<summary>How to install</summary>
					<ol>
						<li>Open the game in <strong>Chrome</strong> on your Android phone.</li>
						<li>
							Tap the menu (⋮) → <strong>Install app</strong> or <strong>Add to Home screen</strong>.
						</li>
						<li>Confirm — Pulse Link appears on your home screen and launches fullscreen.</li>
					</ol>
				</details>
			</div>
		)
	}

	{
		desktop.length > 0 && (
			<div class="block">
				<h3>Desktop</h3>
				<div class="btn-row">
					{desktop.map((item) => (
						<a class="btn btn-ghost" href={item.href} download>
							Download {item.label}
						</a>
					))}
				</div>
			</div>
		)
	}

	{
		desktop.length === 0 && !canInstallAndroid && !androidHref && !showPlayStore && (
			<p class="muted">Downloads are not published yet.</p>
		)
	}
</section>

<style>
	.downloads {
		padding: 2rem 0 0.5rem;
	}

	.intro {
		max-width: 38rem;
		margin-bottom: 1.5rem;
		font-family: var(--font-type);
	}

	.block {
		padding: 1.25rem 0;
		border-top: 1px dashed var(--line);
	}

	.block h3 {
		font-family: var(--font-type);
		font-size: 1.15rem;
		text-transform: none;
		letter-spacing: 0;
		margin-bottom: 0.85rem;
	}

	.help {
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.help summary {
		cursor: pointer;
		font-family: var(--font-type);
		color: var(--paper);
	}

	.help ol {
		margin: 0.75rem 0 0;
		padding-left: 1.2rem;
	}
</style>
