---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}

const {
	title = 'SKITZ',
	description = 'SKITZ — free games and apps. Play in the browser, install on Android.',
	bodyClass = '',
} = Astro.props;

const pageTitle = title === 'SKITZ' ? 'SKITZ — games & apps' : `${title} · SKITZ`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f3eee4" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/images/skitz-mark.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500;600&family=Special+Elite&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
