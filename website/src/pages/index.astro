---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('games'))
	.filter((game) => game.data.released)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout description="SKITZ games & apps — play Pulsefold and SHIFTR free in the browser, including on iPhone.">
	<SiteHeader />
	<main class="site-main">
		<section class="hero">
			<div class="wrap hero__inner">
				<img
					class="hero__logo"
					src="/images/skitz-logo-v2.png"
					alt="SKITZ games & apps"
					width="1024"
					height="1024"
				/>
				<h1 class="sr-only">SKITZ games & apps</h1>
				<p class="hero__line">slapped on the web — free to play, free to download.</p>
				<div class="btn-row hero__cta">
					<a class="btn" href="/games/">Browse games</a>
					{
						games[0] && (
							<a class="btn btn-ghost" href={`/games/${games[0].id}/play/`}>
								Play {games[0].data.title}
							</a>
						)
					}
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.hero {
		min-height: calc(100vh - var(--header-h));
		min-height: calc(100dvh - var(--header-h));
		display: grid;
		place-items: center;
		text-align: center;
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		justify-items: center;
		gap: 1.2rem;
		padding: 2.5rem 0 3.5rem;
	}

	.hero__logo {
		width: min(520px, 86vw);
		height: auto;
		transform: rotate(-1.6deg);
		filter: drop-shadow(10px 12px 0 rgba(0, 0, 0, 0.95));
		animation: slap-in 700ms var(--ease) both;
	}

	.hero__line {
		max-width: 26rem;
		margin: 0;
		font-family: var(--font-type);
		font-size: clamp(1.05rem, 2.4vw, 1.28rem);
		color: var(--paper);
		animation: rise 700ms var(--ease) 80ms both;
	}

	.hero__cta {
		justify-content: center;
		animation: rise 700ms var(--ease) 140ms both;
	}
</style>
