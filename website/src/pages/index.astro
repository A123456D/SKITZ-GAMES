---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('games'))
	.filter((game) => game.data.released)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout description="SKITZ — free games and apps. Play in the browser, install on Android.">
	<SiteHeader />
	<main class="site-main">
		<section class="hero">
			<div class="wrap hero__inner">
				<div class="hero__logo-wrap">
					<img
						class="hero__peek"
						src="/images/skitz-peek.png"
						alt=""
						width="720"
						height="680"
						aria-hidden="true"
						decoding="async"
					/>
					<img
						class="hero__logo"
						src="/images/skitz-mark.png"
						alt="SKITZ games & apps"
						width="1024"
						height="1024"
					/>
				</div>
				<h1 class="sr-only">SKITZ games & apps</h1>
				<p class="hero__line">
					Free games and apps — playful puzzles you can open in the browser, and more on the way.
				</p>
				<div class="btn-row hero__cta">
					<a class="btn" href="/games/">Browse games</a>
					{
						games[0] && (
							<a class="btn btn-ghost" href={`/games/${games[0].id}/play/`}>
								Play {games[0].data.title}
							</a>
						)
					}
				</div>
				<ul class="hero__chips" aria-label="What you get">
					<li>Free games</li>
					<li>Browser play</li>
					<li>Android apps</li>
				</ul>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.hero {
		min-height: calc(100vh - var(--header-h));
		min-height: calc(100dvh - var(--header-h));
		display: grid;
		place-items: center;
		text-align: center;
		overflow: hidden;
		position: relative;
	}

	.hero__inner {
		display: grid;
		justify-items: center;
		gap: 1.15rem;
		padding: 2.5rem 0 3.5rem;
		position: relative;
		z-index: 1;
	}

	.hero__logo-wrap {
		position: relative;
		display: grid;
		place-items: center;
		isolation: isolate;
		overflow: visible;
		animation: slap-in 700ms var(--ease) both;
		padding: 0.85rem 1.4rem 1.6rem;
		margin: -0.6rem -0.6rem -0.4rem;
	}

	.hero__peek {
		position: absolute;
		z-index: 0;
		width: min(108px, 26vw);
		height: auto;
		pointer-events: none;
		user-select: none;
		/* Peek from the lower-left under the mark. */
		left: 10%;
		bottom: 8%;
		transform: rotate(-8deg) translate(-18%, 70%);
		opacity: 0;
		filter: drop-shadow(3px 5px 0 rgba(22, 19, 16, 0.16));
		/* Visible 3s of every 10s cycle. */
		animation: hero-peek-cycle 10s ease-in-out infinite;
		will-change: transform, opacity;
	}

	.hero__logo {
		position: relative;
		z-index: 1;
		width: min(460px, 86vw);
		height: auto;
		filter: drop-shadow(10px 14px 0 rgba(22, 19, 16, 0.22));
		transform: rotate(-1.4deg);
		animation: logo-hover 3.4s ease-in-out infinite;
		will-change: transform;
	}

	@media (max-width: 520px) {
		.hero__logo-wrap {
			padding: 0.65rem 0.9rem 1.25rem;
			margin: -0.4rem -0.3rem -0.2rem;
		}

		.hero__peek {
			width: min(84px, 22vw);
			left: 6%;
			bottom: 6%;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.hero__logo {
			transition:
				transform 180ms var(--ease),
				filter 180ms var(--ease);
		}

		.hero__logo-wrap:hover .hero__logo {
			animation: logo-hover-strong 3.4s ease-in-out infinite;
			filter: drop-shadow(12px 20px 0 rgba(22, 19, 16, 0.28));
		}
	}

	@keyframes logo-hover {
		0%,
		100% {
			transform: rotate(-1.4deg) translateY(0);
		}
		50% {
			transform: rotate(-1.4deg) translateY(-8px);
		}
	}

	@keyframes logo-hover-strong {
		0%,
		100% {
			transform: rotate(-0.4deg) translateY(-4px) scale(1.03);
		}
		50% {
			transform: rotate(-0.4deg) translateY(-14px) scale(1.03);
		}
	}

	/* 10s loop: tuck → peek (~0.4s) → hold to 3s → tuck → wait. */
	@keyframes hero-peek-cycle {
		0%,
		2% {
			opacity: 0;
			transform: rotate(-8deg) translate(-18%, 70%);
		}
		6%,
		30% {
			opacity: 1;
			transform: rotate(-8deg) translate(0, 0);
		}
		34%,
		100% {
			opacity: 0;
			transform: rotate(-8deg) translate(-18%, 70%);
		}
	}

	.hero__line {
		max-width: 28rem;
		margin: 0;
		font-family: var(--font-type);
		font-size: clamp(1.05rem, 2.4vw, 1.28rem);
		color: var(--ink-soft);
		animation: rise 700ms var(--ease) 80ms both;
	}

	.hero__cta {
		justify-content: center;
		animation: rise 700ms var(--ease) 140ms both;
	}

	.hero__chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		animation: rise 700ms var(--ease) 200ms both;
	}

	.hero__chips li {
		font-family: var(--font-type);
		font-size: 0.85rem;
		color: var(--mark);
		background:
			linear-gradient(160deg, #fffef9, var(--paper));
		border: 2px solid var(--mark);
		padding: 0.35rem 0.7rem;
		box-shadow: 3px 3px 0 var(--skitz-green);
		transform: rotate(-1deg);
	}

	.hero__chips li:nth-child(2) {
		box-shadow: 3px 3px 0 var(--skitz-blue);
		transform: rotate(1.2deg);
	}

	.hero__chips li:nth-child(3) {
		box-shadow: 3px 3px 0 var(--skitz-red);
		transform: rotate(-0.4deg);
	}
</style>
