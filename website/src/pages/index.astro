---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('games'))
	.filter((game) => game.data.released)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout description="SKITZ — sticker-bright indie games. Free to play in the browser, install on Android, tip only if you want.">
	<SiteHeader />
	<main class="site-main">
		<section class="hero">
			<div class="wrap hero__inner">
				<div class="hero__logo-plate">
					<img
						class="hero__logo"
						src="/images/skitz-logo-v2.png"
						alt="SKITZ games & apps"
						width="1024"
						height="1024"
					/>
				</div>
				<h1 class="sr-only">SKITZ games & apps</h1>
				<p class="hero__line">
					Color-slap puzzles on the web. Free to play. Freemium extras later — never paywalled to
					start.
				</p>
				<div class="btn-row hero__cta">
					<a class="btn" href="/games/">Browse games</a>
					{
						games[0] && (
							<a class="btn btn-ghost" href={`/games/${games[0].id}/play/`}>
								Play {games[0].data.title}
							</a>
						)
					}
				</div>
				<ul class="hero__chips" aria-label="What you get">
					<li>Free web play</li>
					<li>Android install</li>
					<li>Optional tips</li>
				</ul>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.hero {
		min-height: calc(100vh - var(--header-h));
		min-height: calc(100dvh - var(--header-h));
		display: grid;
		place-items: center;
		text-align: center;
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		justify-items: center;
		gap: 1.15rem;
		padding: 2.5rem 0 3.5rem;
	}

	.hero__logo-plate {
		background: #fff;
		padding: 0.85rem 1rem 1rem;
		transform: rotate(-1.6deg);
		box-shadow:
			10px 12px 0 #000,
			0 0 0 3px var(--skitz-yellow);
		clip-path: polygon(
			1.5% 2%,
			8% 0%,
			18% 2.5%,
			32% 0.5%,
			48% 2%,
			62% 0%,
			78% 2.2%,
			92% 0.8%,
			100% 3%,
			98.5% 18%,
			100% 34%,
			98% 52%,
			100% 68%,
			98.5% 84%,
			100% 97%,
			86% 100%,
			70% 98%,
			52% 100%,
			34% 98.5%,
			18% 100%,
			4% 97.5%,
			0% 84%,
			1.5% 68%,
			0% 50%,
			2% 32%,
			0% 14%
		);
		animation: slap-in 700ms var(--ease) both;
	}

	.hero__logo {
		width: min(480px, 82vw);
		height: auto;
		transform: none;
		filter: none;
		animation: none;
	}

	.hero__line {
		max-width: 28rem;
		margin: 0;
		font-family: var(--font-type);
		font-size: clamp(1.05rem, 2.4vw, 1.28rem);
		color: var(--paper);
		animation: rise 700ms var(--ease) 80ms both;
	}

	.hero__cta {
		justify-content: center;
		animation: rise 700ms var(--ease) 140ms both;
	}

	.hero__chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		animation: rise 700ms var(--ease) 200ms both;
	}

	.hero__chips li {
		font-family: var(--font-type);
		font-size: 0.85rem;
		color: var(--mark);
		background: var(--paper);
		border: 2px solid #000;
		padding: 0.35rem 0.7rem;
		box-shadow: 3px 3px 0 var(--skitz-green);
		transform: rotate(-1deg);
	}

	.hero__chips li:nth-child(2) {
		box-shadow: 3px 3px 0 var(--skitz-blue);
		transform: rotate(1.2deg);
	}

	.hero__chips li:nth-child(3) {
		box-shadow: 3px 3px 0 var(--skitz-red);
		transform: rotate(-0.4deg);
	}
</style>
