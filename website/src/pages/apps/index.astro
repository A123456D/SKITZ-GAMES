---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GameCard from '../../components/GameCard.astro';
import { getCollection } from 'astro:content';

const apps = (await getCollection('apps')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Apps" description="Browse SKITZ apps — free tools in the browser, install on Android.">
	<SiteHeader />
	<main class="site-main">
		<section class="section">
			<div class="wrap">
				<p class="eyebrow">catalog</p>
				<h1 class="section-title">Apps</h1>
				<p class="lead muted">
					Free utilities and tools — open in the browser, install on Android.
				</p>
				<div class="list">
					{
						apps.map((app) => (
							<GameCard
								href={`/apps/${app.id}/`}
								title={app.data.title}
								summary={app.data.summary}
								cover={app.data.cover}
								preview={app.data.preview}
								genre={app.data.genre}
								cta="view app →"
							/>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.lead {
		max-width: 34rem;
		margin-bottom: 1.75rem;
		font-family: var(--font-type);
	}

	.list {
		display: grid;
		gap: 1.75rem 1.35rem;
		animation: rise 500ms var(--ease);
	}

	@media (min-width: 700px) {
		.list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 1.75rem;
			align-items: start;
		}
	}
</style>
