---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const games = await getCollection('games');
	return games
		.filter((game) => game.data.platforms.web)
		.map((game) => ({
			params: { slug: game.id },
			props: { game },
		}));
}

const { game } = Astro.props;
// Top-level navigation (not iframe) so Android Chrome can install the PWA.
return Astro.redirect(`/games/${game.id}/${game.data.webPlayPath}`);
