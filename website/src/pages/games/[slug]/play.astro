---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlayFrame from '../../../components/PlayFrame.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const games = await getCollection('games');
	return games
		.filter((game) => game.data.platforms.web)
		.map((game) => ({
			params: { slug: game.id },
			props: { game },
		}));
}

const { game } = Astro.props;
const src = `/games/${game.id}/${game.data.webPlayPath}`;
---

<BaseLayout
	title={`Play ${game.data.title}`}
	description={`Play ${game.data.title} free in your browser — works on desktop, Android, and iPhone.`}
	bodyClass="play-page"
>
	<PlayFrame title={game.data.title} src={src} />
</BaseLayout>

<style is:global>
	.play-page {
		background: #000;
		margin: 0;
		overflow: hidden;
		height: 100%;
		min-height: 100dvh;
	}

	html:has(.play-page) {
		height: 100%;
		overflow: hidden;
	}

	.play-page::before {
		opacity: 0.04;
	}

	@media (max-width: 820px), (pointer: coarse) {
		.play-page::before,
		.play-page::after {
			display: none;
		}
	}
</style>
