---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import DownloadPanel from '../../../components/DownloadPanel.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const games = await getCollection('games');
	return games.map((game) => ({
		params: { slug: game.id },
		props: { game },
	}));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, summary, tagline, cover, platforms, downloads, appStoreUrl, playStoreUrl, genre } =
	game.data;
---

<BaseLayout title={title} description={summary}>
	<SiteHeader />
	<main class="site-main">
		<section class="detail-hero">
			<div class="wrap detail-hero__grid">
				<div class="detail-hero__copy">
					{genre && <p class="eyebrow">{genre}</p>}
					<h1>{title}</h1>
					{tagline && <p class="tagline">{tagline}</p>}
					<p class="muted">{summary}</p>
					<div class="btn-row">
						{
							platforms.web && (
								<a class="btn" href={`/games/${game.id}/play/`}>
									Play online
								</a>
							)
						}
						<a class="btn btn-ghost" href="#install">Download</a>
					</div>
				</div>
				<div class="detail-hero__art">
					<img src={cover} alt={`${title} cover art`} width="640" height="640" />
				</div>
			</div>
		</section>

		<section class="section">
			<div class="wrap prose">
				<h2 class="section-title">About</h2>
				<Content />
			</div>
		</section>

		<section class="section" id="downloads">
			<div class="wrap">
				<DownloadPanel
					slug={game.id}
					title={title}
					downloads={downloads}
					appStoreUrl={appStoreUrl}
					playStoreUrl={playStoreUrl}
					platforms={platforms}
				/>
			</div>
		</section>

		<section class="section free-note">
			<div class="wrap">
				<p class="eyebrow">free</p>
				<h2 class="section-title">Play free. Install free.</h2>
				<div class="sticker free-card">
					<p>
						Full web play, Android install from Chrome, and the whole puzzle loop — no account
						wall, no paywall on the desks.
					</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.detail-hero {
		padding: 2.5rem 0 1rem;
		animation: rise 550ms var(--ease);
	}

	.detail-hero__grid {
		display: grid;
		gap: 2rem;
		align-items: center;
	}

	@media (min-width: 860px) {
		.detail-hero__grid {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 2.5rem;
		}
	}

	.detail-hero h1 {
		font-size: clamp(2.8rem, 8vw, 5rem);
		margin-bottom: 0.35rem;
	}

	.tagline {
		font-family: var(--font-type);
		font-size: 1.2rem;
		margin-bottom: 0.75rem;
		color: var(--paper);
	}

	.detail-hero__art {
		max-width: 340px;
		margin-inline: auto;
		background: #fff;
		padding: 0.65rem;
		box-shadow: 8px 9px 0 var(--skitz-purple);
		clip-path: polygon(
			1.5% 2%,
			8% 0%,
			18% 2.5%,
			32% 0.5%,
			48% 2%,
			62% 0%,
			78% 2.2%,
			92% 0.8%,
			100% 3%,
			98.5% 18%,
			100% 34%,
			98% 52%,
			100% 68%,
			98.5% 84%,
			100% 97%,
			86% 100%,
			70% 98%,
			52% 100%,
			34% 98.5%,
			18% 100%,
			4% 97.5%,
			0% 84%,
			1.5% 68%,
			0% 50%,
			2% 32%,
			0% 14%
		);
		transform: rotate(1.4deg);
	}

	.detail-hero__art img {
		width: 100%;
		height: auto;
		display: block;
	}

	.prose :global(p) {
		max-width: 40rem;
		color: var(--muted);
		font-family: var(--font-type);
	}

	.free-card {
		padding: 1.35rem 1.25rem 1.2rem;
		max-width: 36rem;
		transform: rotate(-0.8deg);
		margin-top: 0.5rem;
	}

	.free-card p {
		margin: 0;
		font-family: var(--font-type);
		color: var(--mark);
		font-size: 1.05rem;
	}
</style>
