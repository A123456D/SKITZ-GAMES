---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About" description="About SKITZ — freemium sticker games slapped on the web.">
	<SiteHeader />
	<main class="site-main">
		<section class="section">
			<div class="wrap about">
				<p class="eyebrow">studio</p>
				<h1 class="section-title">About SKITZ</h1>
				<div class="sticker about-card">
					<p>
						SKITZ is a loud little mark for the games we slap on the internet — purple, red,
						green, blue, yellow, black. Browser-first puzzles you can play on phone or PC.
					</p>
					<p>
						<strong>Freemium, not gated:</strong> the core run is free. Android install from Chrome
						is free. If we add cosmetics, tip jars, or packs later, they stay optional.
					</p>
					<p>No accounts to start. No “watch an ad to fold.” Just the games — and optional support.</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.about {
		max-width: 40rem;
		animation: rise 500ms var(--ease);
	}

	.about-card {
		padding: 1.6rem 1.5rem 1.4rem;
		transform: rotate(-0.7deg);
		box-shadow: 8px 9px 0 var(--skitz-purple);
	}

	.about-card p {
		font-family: var(--font-type);
		font-size: 1.15rem;
		color: var(--mark);
		margin-bottom: 0.85rem;
	}

	.about-card p:last-child {
		margin-bottom: 0;
	}
</style>
