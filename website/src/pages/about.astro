---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About" description="About SKITZ — freemium games and apps for the web and beyond.">
	<SiteHeader />
	<main class="site-main">
		<section class="section">
			<div class="wrap about">
				<p class="eyebrow">studio</p>
				<h1 class="section-title">About SKITZ</h1>
				<div class="sticker about-card">
					<p>
						SKITZ makes freemium games and apps — sticker-bright puzzles and playful tools you can
						open in a browser or install on Android.
					</p>
					<p>
						Everything starts free. No accounts to try a game. Cosmetics, tips, or extras may show
						up later, but they stay optional.
					</p>
					<p>Just the games and apps — and optional support if you want to keep the desk going.</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.about {
		max-width: 40rem;
		animation: rise 500ms var(--ease);
	}

	.about-card {
		padding: 1.6rem 1.5rem 1.4rem;
		transform: rotate(-0.7deg);
		box-shadow: 8px 9px 0 var(--skitz-purple);
	}

	.about-card p {
		font-family: var(--font-type);
		font-size: 1.15rem;
		color: var(--mark);
		margin-bottom: 0.85rem;
	}

	.about-card p:last-child {
		margin-bottom: 0;
	}
</style>
