---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About" description="About SKITZ games & apps.">
	<SiteHeader />
	<main class="site-main">
		<section class="section">
			<div class="wrap about">
				<p class="eyebrow">studio</p>
				<h1 class="section-title">About SKITZ</h1>
				<div class="sticker about-card">
					<p>
						SKITZ games &amp; apps is a sticker on the internet for the things we make. Play free
						in the browser — including on iPhone — or download builds for Windows and Android.
					</p>
					<p>
						No accounts. No paywalls. Just the games.
					</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.about {
		max-width: 40rem;
		animation: rise 500ms var(--ease);
	}

	.about-card {
		padding: 1.6rem 1.5rem 1.4rem;
		transform: rotate(-0.7deg);
	}

	.about-card p {
		font-family: var(--font-type);
		font-size: 1.15rem;
		color: var(--mark);
		margin-bottom: 0.85rem;
	}

	.about-card p:last-child {
		margin-bottom: 0;
	}
</style>
