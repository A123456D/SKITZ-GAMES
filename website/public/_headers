# PulseFold is a Vite/canvas game and does not need SharedArrayBuffer.
# Restrictive COOP/COEP headers break the play-page iframe embed.

# OCULUM — never pin the HTML shell / SW (Android Chrome was stuck on old builds)
/games/oculum/web/
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/web/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/web/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/web/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Card faces keep stable filenames — never immutable (SPA HTML 200s were sticky)
/games/oculum/web/assets/cards/*
  Cache-Control: public, max-age=3600, must-revalidate

/games/oculum/b9/
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/b9/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/b9/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/games/oculum/b9/assets/*
  Cache-Control: public, max-age=31536000, immutable

/games/oculum/b9/assets/cards/*
  Cache-Control: public, max-age=3600, must-revalidate
