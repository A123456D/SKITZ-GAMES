{
  "name": "pc-controller",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "sync:android": "npm run build && npx cap sync android",
