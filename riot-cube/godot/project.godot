; RIOT CUBE — Godot 4.7 mobile-first (Android export path)
config_version=5

[application]

config/name="RIOT CUBE"
config/description="Twist slices. Rip matches. Clear the riot."
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/dpi/allow_hidpi=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[input]

ui_restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}

[physics]

common/physics_ticks_per_second=20
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.0470588, 0.0470588, 0.0470588, 1)

[debug]

gdscript/warnings/inferred_declaration=1
gdscript/warnings/untyped_declaration=1
gdscript/warnings/native_method_override=1
